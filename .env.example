# =============================================================================
# Smart City Urban Analytics Platform - Environment Configuration Template
# Copy this file to '.env' and populate with your local credentials.
# =============================================================================

# Database Configuration (MySQL 8.4)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_city_db

# Backend API Configuration
PORT=5000
NODE_ENV=development
# Allowed CORS origins in production (comma-separated; leave empty for open local dev)
CORS_ORIGIN=http://localhost:5173

# Python Machine Learning Inference Service
# Production (Render): Full HTTPS URL of your separately deployed Python ML service:
ML_SERVICE_URL=https://smart-city-dhj4.onrender.com

# Local Development: Fallback host/port for local persistent Python daemon (default: 127.0.0.1:5001):
ML_DAEMON_HOST=127.0.0.1
ML_DAEMON_PORT=5001

# Authentication & Security
# Generate a strong 64-character secret for production
JWT_SECRET=your_super_secret_jwt_key_here
